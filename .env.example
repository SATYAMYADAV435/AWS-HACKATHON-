# KisanMitra Environment Configuration
# Mode switches (defaults per ARCHITECTURE.md §7)
USE_CACHE=true
MANDI_MODE=csv
KB_MODE=s3
LANG_MODE=llm
STT_PROVIDER=browser
TTS_PROVIDER=browser

# AWS Bedrock Models
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MODEL_ID_FALLBACK=amazon.titan-text-express-v1
BEDROCK_VISION_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# AWS Region & S3 Image Storage
AWS_DEFAULT_REGION=ap-south-1
S3_BUCKET_NAME=kisanmitra-crop-images

# Supabase Authentication & Multi-Farm Storage (Optional - local fallback active by default)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional Third-party Voice APIs
SARVAM_API_KEY=

